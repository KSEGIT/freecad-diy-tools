<?xml version="1.0" encoding="UTF-8"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>FreeCAD DIY tools</name>
  <description>Independent timber and plywood tools with magnetic placement, measurements, cut sizing and rotation.</description>
  <version>0.6.0</version>
  <date>2026-10-02</date>
  <maintainer>KSEGIT</maintainer>
  <license>UNLICENSED</license>
  <url type="repository" branch="main">https://github.com/KSEGIT/freecad-diy-tools</url>
  <icon>DIYWorkbenchTools/WorkbenchParts.svg</icon>
  <!-- FreeCAD 1.1 uses the workbench content loader for GUI extensions.
       No classname: this entry loads InitGui without registering a workbench. -->
  <content>
    <workbench>
      <name>DIY tools toolbar</name>
      <description>Universal toolbar for editable timber and plywood parts.</description>
      <subdirectory>DIYWorkbenchTools</subdirectory>
      <icon>WorkbenchParts.svg</icon>
      <freecadmin>1.1.0</freecadmin>
    </workbench>
  </content>
</package>
